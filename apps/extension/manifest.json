{
  "manifest_version": 3,
  "name": "FluentFrame",
  "version": "0.1.0",
  "description": "Turn YouTube captions into local bilingual subtitles and English learning notes.",
  "permissions": ["nativeMessaging", "activeTab", "scripting"],
  "host_permissions": ["https://www.youtube.com/*"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*"],
      "js": ["content.js"],
      "css": ["styles.css"]
    }
  ],
  "action": {
    "default_title": "FluentFrame",
    "default_popup": "popup.html"
  }
}
