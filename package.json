{
  "name": "fluent-frame",
  "private": true,
  "version": "0.1.0",
  "license": "MIT",
  "description": "Local-first Chrome extension for bilingual YouTube subtitles and English learning notes.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/OctopusGarage/fluent-frame.git"
  },
  "homepage": "https://github.com/OctopusGarage/fluent-frame#readme",
  "bugs": {
    "url": "https://github.com/OctopusGarage/fluent-frame/issues"
  },
  "type": "module",
  "packageManager": "pnpm@10.13.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm --filter @fluent-frame/shared build && pnpm -r test && pnpm run test:scripts",
    "test:scripts": "node --test scripts/tests/*.test.mjs",
    "typecheck": "pnpm --filter @fluent-frame/shared build && pnpm -r typecheck",
    "lint": "pnpm --filter @fluent-frame/shared build && pnpm -r lint",
    "e2e": "pnpm build && playwright test",
    "e2e:ci": "pnpm build && xvfb-run -a playwright test e2e/extension.spec.ts",
    "e2e:live": "pnpm build && FF_LIVE_YOUTUBE=1 playwright test e2e/live-youtube.spec.ts",
    "eval:ai": "pnpm --filter @fluent-frame/shared build && pnpm --filter @fluent-frame/native-host build && node scripts/ai-eval.mjs",
    "audit": "pnpm audit --audit-level high",
    "verify:local": "scripts/verify-local.sh",
    "setup": "node scripts/setup-local.mjs",
    "local:install": "node scripts/setup-local.mjs",
    "local:update": "node scripts/update-local.mjs",
    "local:open": "node scripts/open-local.mjs",
    "doctor": "node scripts/doctor.mjs",
    "ff:doctor": "node scripts/doctor.mjs",
    "link:chrome": "node scripts/link-chrome.mjs",
    "uninstall:local": "node scripts/uninstall-local.mjs"
  },
  "pnpm": {
    "overrides": {
      "nanoid": "3.3.18",
      "postcss": "8.5.26"
    }
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^24.0.0",
    "@vitest/coverage-v8": "3.2.7",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  }
}
